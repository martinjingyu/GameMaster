# Copy this file to .env and fill in the values for your LLM provider.
# The client uses an OpenAI-compatible /chat/completions endpoint.

# OpenAI-compatible hosted API. For DeepSeek, use:
# GAMEMASTER_LLM_BASE_URL=https://api.deepseek.com
# GAMEMASTER_LLM_MODEL=deepseek-chat
GAMEMASTER_LLM_BASE_URL=https://api.openai.com/v1
GAMEMASTER_LLM_API_KEY=
GAMEMASTER_LLM_MODEL=

# Optional tuning:
GAMEMASTER_LLM_TEMPERATURE=0.4
GAMEMASTER_LLM_TIMEOUT_SECONDS=30

# In local testing, keep this false so only the web test console can run
# storyteller control commands such as /start, /night, /resolve, /kill.
GAMEMASTER_ALLOW_PLAYER_ST_COMMANDS=false
